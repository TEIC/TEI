<?xml-model href="https://jenkins-paderborn.tei-c.org/view/LingSIG/job/TEIP5-LingSIG-att.linguistic.dependency/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl" type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<classSpec xmlns="http://www.tei-c.org/ns/1.0" module="analysis" xml:id="ATTLINGDEP" type="atts" ident="att.linguistic.dependency">
  <desc versionDate="2025-02-21" xml:lang="en">provides attributes for annotating dependency relations between word-level elements.</desc>
  <classes/>
  <attList>
    <attDef ident="head" usage="opt">
      <gloss versionDate="2025-02-21" xml:lang="en">syntactic head of a dependency relation</gloss>
      <desc versionDate="2025-02-21" xml:lang="en">encodes a syntactic
        dependency relation between the element bearing this attribute and its
        syntactic head, i.e. the element having the attribute value as the value of
        its <att>n</att> attribute.</desc>
      <datatype minOccurs="1" maxOccurs="unbounded"><dataRef key="teidata.word"/></datatype>
    </attDef>
    <attDef ident="deprel" usage="opt">
      <gloss versionDate="2025-02-21" xml:lang="en">type of a dependency relation</gloss>
      <desc versionDate="2025-02-21" xml:lang="en">provides a label for the type
        of the syntactic dependency relation between the element bearing this
        attribute and the element identified by its <att>head</att> attribute.</desc>
      <datatype minOccurs="1" maxOccurs="unbounded"><dataRef key="teidata.word"/></datatype>
    </attDef>
  </attList>
  <exemplum xml:lang="en">
    <p>Universal Dependency (UD) annotation of the English sentence <q>They buy books.</q>.</p>
    <egXML xmlns="http://www.tei-c.org/ns/Examples">
      <s n="0">
        <w n="1" head="2" deprel="nsubj" pos="PRON" lemma="they">They</w>
        <w n="2" head="0" deprel="root" pos="VERB" lemma="buy">buy</w>
        <w n="3" head="2" deprel="obj" pos="NOUN" lemma="book" join="right">books</w>
        <pc n="4" head="2" deprel="punct" pos="PUNCT" lemma=".">.</pc>
      </s>
    </egXML>
  </exemplum>
  <exemplum xml:lang="en">
    <p>Universal Dependency (UD) annotation of the English sentence <q>They
      buy and sell books.</q>.</p>
    <egXML xmlns="http://www.tei-c.org/ns/Examples">
      <s n="0">
        <w n="1" head="2 4" deprel="nsubj nsubj" pos="PRON PRP" msd="Case=Nom|Number=Plur" lemma="they">They</w>
        <w n="2" head="0" deprel="root" pos="VERB VBP" msd="Number=Plur|Person=3|Tense=Pres" lemma="buy">buy</w>
        <w n="3" head="4" deprel="cc" pos="CCONJ CC" lemma="and">and</w>
        <w n="4" head="2 0" deprel="conj root" pos="VERB VBP" msd="Number=Plur|Person=3|Tense=Pres" lemma="sell">sell</w>
        <w n="5" head="2 4" deprel="obj obj" pos="NOUN NNS" msd="Number=Plur" lemma="book" join="right">books</w>
        <pc n="6" head="2" deprel="punct" pos="PUNCT ." lemma=".">.</pc>
      </s>
    </egXML>
  </exemplum>
  <remarks xml:lang="en" versionDate="2025-03-13">
    <p>The following table summarises the serialisation choices for the CoNLL-U format in TEI XML.
      <table cols="3">
        <row role="label">
          <cell>CoNLL-U column</cell>
          <cell>TEI representation</cell>
          <cell>TEI class</cell>
        </row>
        <row>
          <cell><code>ID</code></cell>
          <cell><att>n</att></cell>
          <cell><ident type="class">att.global</ident></cell>
        </row>
        <row>
          <cell><code>FORM</code></cell>
          <cell><gi>w</gi> or <gi>pc</gi> content</cell>
          <cell><ident type="class">model.segLike</ident></cell>
        </row>
        <row>
          <cell><code>LEMMA</code></cell>
          <cell><att>lemma</att></cell>
          <cell><ident type="class">att.linguistic</ident></cell>
        </row>
        <row>
          <cell><code>UPOS</code></cell>
          <cell><att>pos</att></cell>
          <cell><ident type="class">att.linguistic</ident></cell>
        </row>
        <row>
          <cell><code>XPOS</code></cell>
          <cell>additional list item in <att>pos</att></cell>
          <cell><ident type="class">att.linguistic</ident></cell>
        </row>
        <row>
          <cell><code>FEATS</code></cell>
          <cell><att>msd</att></cell>
          <cell><ident type="class">att.linguistic</ident></cell>
        </row>
        <row>
          <cell><code>HEAD</code></cell>
          <cell><att>head</att></cell>
          <cell><ident type="class">att.linguistic.dependency</ident></cell>
        </row>
        <row>
          <cell><code>DEPREL</code></cell>
          <cell><att>deprel</att></cell>
          <cell><ident type="class">att.linguistic.dependency</ident></cell>
        </row>
        <row>
          <cell><code>DEPS</code></cell>
          <cell>additional list items in <att>head</att> and <att>deprel</att></cell>
          <cell><ident type="class">att.linguistic.dependency</ident></cell>
        </row>
        <row>
          <cell><code>SpaceAfter=No</code> in <code>MISC</code></cell>
          <cell><att>join</att> with value <val>right</val></cell>
          <cell><ident type="class">att.linguistic</ident></cell>
        </row>
      </table>
    </p>
  </remarks>
  <listRef>
    <ptr target="#AILADEP"/>
  </listRef>
</classSpec>
