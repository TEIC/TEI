<?xml-model href="https://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl" type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec xmlns="http://www.tei-c.org/ns/1.0" module="tagdocs" ident="modelGrp" xml:id="gi-modelGrp">
  <gloss versionDate="2022-06-09" xml:lang="en">model group</gloss>
  <desc versionDate="2026-09-22" xml:lang="en">any grouping of <gi>model</gi> or <gi>modelSequence</gi> elements.</desc>
  <classes>
    <memberOf key="att.global"/>
    </classes>
  <content>
    <sequence>
      <alternate minOccurs="0" maxOccurs="unbounded">
        <classRef key="model.identEquiv"/>
        <classRef key="model.descLike"/>
      </alternate>
      <alternate minOccurs="1" maxOccurs="unbounded">
        <elementRef key="modelSequence"/>
        <elementRef key="model"/>
      </alternate>
    </sequence>
  </content>
  <exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-modelGrp-egXML-mt" source="#UND">
      <elementSpec mode="change" ident="choice">
        <modelGrp>
          <desc>Models for outputs that are likely to be printed (including Word)</desc>
          <model output="fo" behaviour="pass-through"/>
          <model output="print" behaviour="pass-through"/>
          <model output="docx" behaviour="pass-through"/>
        </modelGrp>
        <modelGrp>
          <desc>Models for other outputs, supporting interactive features</desc>
          <model predicate="$mode='diplomatic'" behaviour="alternate">
            <desc>For diplomatic mode present source version as default</desc>
            <param name="default" value="(sic, orig, abbr, tail(seg))"/>
            <param name="alternate" value="(corr, reg, expan, head(seg))"/>
          </model>
          <model behaviour="alternate">
            <desc>For any other mode or output present edited version as default</desc>
            <param name="default" value="(corr, reg, expan, head(seg))"/>
            <param name="alternate" value="(sic, orig, abbr, tail(seg))"/>
          </model>
        </modelGrp>
      </elementSpec>
    </egXML>
  </exemplum>
  <remarks ident="modelGrp-remarks" versionDate="2015-08-21" xml:lang="en">
    <p>The <gi>modelGrp</gi> element may be used to group <gi>model</gi> and <gi>modelSequence</gi> 
      elements for any purpose. Usually a <gi>desc</gi> element will be used in conjunction, to document 
      the purpose of the group or any characteristics its members may share.</p>
    <p>Presence of <gi>modelGrp</gi> does not affect the processing defined by its descendant elements 
      in any way. The nested <gi>model</gi> and <gi>modelSequence</gi> elements of a <gi>modelGrp</gi> 
      are always evaluated and processed independently, in accordance with their respective specifications.</p>
  </remarks>
  <listRef>
    <ptr target="#TDPMMC"/>
  </listRef>
</elementSpec>